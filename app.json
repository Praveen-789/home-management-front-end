{
  "expo": {
    "name": "Home Hub",
    "slug": "home-hub",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/homehub-logo-source.png",
    "scheme": "homehub",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/homehub-logo-source.png"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#026F5B",
        "foregroundImage": "./assets/images/homehub-logo-source.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.praveen_dev.homehub",
      "googleServicesFile": "./google-services.json",
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#026F5B",
          "image": "./assets/images/splash-logo.png",
          "imageWidth": 200
        }
      ],
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/notification-icon.png",
          "color": "#026F5B"
        }
      ],
      "@react-native-vector-icons/material-design-icons",
      "expo-image",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow $(PRODUCT_NAME) to use your photos for tasks and expenses.",
          "cameraPermission": "Allow $(PRODUCT_NAME) to take photos for tasks and expenses."
        }
      ],
      "expo-web-browser",
      "@react-native-google-signin/google-signin"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "0f23eae9-283c-41ee-9d76-6e1d4ac95ead"
      }
    }
  }
}
